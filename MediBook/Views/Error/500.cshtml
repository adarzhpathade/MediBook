@{
    ViewData["Title"] = "Server Error";
    Layout = "_AppLayout";
}

<div class="d-flex align-items-center justify-content-center min-vh-100" style="margin-top: -80px;">
    <div class="text-center bg-white p-5 rounded-4 shadow-sm" style="max-width: 600px; width: 100%;">
        <div class="mb-4">
            <span class="material-symbols-outlined text-warning" style="font-size: 120px; font-variation-settings: 'FILL' 0, 'wght' 200;">warning</span>
        </div>
        <h1 class="display-3 fw-bold text-dark mb-2">500</h1>
        <h3 class="fw-bold text-dark mb-3">Internal Server Error</h3>
        <p class="text-muted fs-5 mb-5">Something went wrong on our end. Our technical team has been notified. Please try again later.</p>
        
        <div class="d-flex justify-content-center gap-3">
            <button onclick="location.reload()" class="btn btn-dark rounded-pill px-4 py-2 fw-bold">
                Try Again
            </button>
            <a href="/" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold">
                Return Home
            </a>
        </div>
    </div>
</div>
