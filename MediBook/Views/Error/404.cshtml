@{
    ViewData["Title"] = "Page Not Found";
    Layout = "_AppLayout";
}

<div class="d-flex align-items-center justify-content-center min-vh-100" style="margin-top: -80px;">
    <div class="text-center bg-white p-5 rounded-4 shadow-sm" style="max-width: 600px; width: 100%;">
        <div class="mb-4">
            <span class="material-symbols-outlined text-muted" style="font-size: 120px; font-variation-settings: 'FILL' 0, 'wght' 200;">search_off</span>
        </div>
        <h1 class="display-3 fw-bold text-dark mb-2">404</h1>
        <h3 class="fw-bold text-dark mb-3">Page Not Found</h3>
        <p class="text-muted fs-5 mb-5">We couldn't find the page you're looking for. It might have been moved, renamed, or doesn't exist.</p>
        
        <div class="d-flex justify-content-center gap-3">
            <button onclick="history.back()" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold">
                Go Back
            </button>
            <a href="/" class="btn btn-dark rounded-pill px-4 py-2 fw-bold">
                Return Home
            </a>
        </div>
    </div>
</div>
