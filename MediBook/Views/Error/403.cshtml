@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AppLayout";
}

<div class="d-flex align-items-center justify-content-center min-vh-100" style="margin-top: -80px;">
    <div class="text-center bg-white p-5 rounded-4 shadow-sm" style="max-width: 600px; width: 100%;">
        <div class="mb-4">
            <span class="material-symbols-outlined text-danger" style="font-size: 120px; font-variation-settings: 'FILL' 0, 'wght' 200;">lock_person</span>
        </div>
        <h1 class="display-3 fw-bold text-dark mb-2">403</h1>
        <h3 class="fw-bold text-dark mb-3">Access Denied</h3>
        <p class="text-muted fs-5 mb-5">You do not have permission to access this resource. Please ensure you are logged in with the correct account.</p>
        
        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-dark rounded-pill px-4 py-2 fw-bold">
                Return Home
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger rounded-pill px-4 py-2 fw-bold">
                Sign Out
            </a>
        </div>
    </div>
</div>
