@model MediBook.Models.ViewModels.BookAppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
    Layout = "_AppLayout";
}

<div class="mb-5">
    <h2 class="display-5 fw-bold text-dark mb-2">Book Appointment</h2>
    

</div>

<form asp-action="BookAppointment" method="post" id="bookingForm">
    <input type="hidden" asp-for="DoctorId" />
    <input type="hidden" asp-for="SelectedDate" id="SelectedDate" />
    <input type="hidden" asp-for="SelectedTime" id="SelectedTime" />

    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-lg-8 d-flex flex-column gap-4">
            <!-- Doctor Summary Card -->
            <div class="bg-white rounded-4 p-4 shadow-sm border-0 d-flex align-items-center gap-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 overflow-hidden" style="width: 80px; height: 80px; background-color: rgba(191, 212, 255, 0.2); color: var(--mb-accent-blue);">
                    @if(!string.IsNullOrEmpty(Model.Doctor.ProfileImage))
                    {
                        <img src="@Model.Doctor.ProfileImage" alt="@Model.Doctor.FullName" class="w-100 h-100" style="object-fit: cover;"/>
                    }
                    else
                    {
                        <span class="material-symbols-outlined fs-1">stethoscope</span>
                    }
                </div>
                <div class="flex-grow-1">
                    <h3 class="fs-4 fw-bold text-dark mb-1">@Model.Doctor.FullName</h3>
                    <p class="text-muted m-0">@Model.Doctor.Specialization &bull; @(Model.Doctor.Experience ?? 0) Yrs Exp.</p>
                </div>
                <a asp-action="FindDoctors" class="btn btn-outline-dark rounded-pill fw-bold px-4">Change</a>
            </div>

            <!-- Calendar & Time Selection -->
            <div class="bg-white rounded-4 p-4 shadow-sm border-0">
                <h3 class="fs-5 fw-bold text-dark mb-4">Select Date &amp; Time</h3>
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 mb-4">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <div class="row g-4">
                    <!-- Date Picker -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark mb-2">Date</label>
                        <input type="date" id="datePicker" class="form-control rounded-pill px-4 py-3 bg-light border-0" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" max="@DateTime.UtcNow.AddDays(5).ToString("yyyy-MM-dd")" required />
                    </div>

                    <!-- Time Slots -->
                    <div class="col-md-6">
                        <h4 class="fs-6 fw-bold text-dark mb-3" id="slotsHeader">Select a date to see times</h4>
                        <div id="slotsContainer" class="d-flex flex-wrap gap-2">
                            <!-- Slots will be populated by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Visit Details -->
            <div class="bg-white rounded-4 p-4 shadow-sm border-0">
                <h3 class="fs-5 fw-bold text-dark mb-4">Visit Details</h3>
                <div>
                    <label class="form-label fw-bold text-dark mb-2">Reason for Visit</label>
                    <textarea asp-for="Reason" class="form-control rounded-4 px-4 py-3 bg-light border-0 resize-none" placeholder="Any specific symptoms or questions?" rows="3" style="resize: none;"></textarea>
                </div>
            </div>
        </div>

        <!-- Right Column (Sticky) -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 2rem;">
                <!-- Summary Card -->
                <div class="bg-white rounded-4 p-4 shadow-sm border-0 mb-4">
                    <h3 class="fs-5 fw-bold text-dark mb-4">Summary</h3>
                    <div class="d-flex align-items-start gap-3 mb-4 pb-4 border-bottom">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; background-color: rgba(244, 183, 216, 0.2); color: var(--mb-accent-pink);">
                            <span class="material-symbols-outlined">event</span>
                        </div>
                        <div>
                            <p class="fw-bold text-dark m-0" id="summaryDate">Not Selected</p>
                            <p class="text-muted m-0" id="summaryTime">--:--</p>
                            <p class="small fw-bold text-primary mt-1">@Model.Doctor.FullName</p>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between text-muted mb-2">
                            <span>Consultation Base</span>
                            <span>₹@(Model.Doctor.ConsultationFee?.ToString("0.00") ?? "0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold text-dark pt-3 border-top">
                            <span>Total Estimate</span>
                            <span>₹@(Model.Doctor.ConsultationFee?.ToString("0.00") ?? "0.00")</span>
                        </div>
                    </div>
                    <button type="button" id="submitBtn" class="btn btn-dark w-100 rounded-pill py-3 fw-bold shadow-sm" disabled>
                        Confirm &amp; Book
                    </button>
                </div>

                <!-- Policies Card -->
                <div class="bg-light rounded-4 p-4 border-0">
                    <h4 class="fs-6 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined fs-5">info</span>
                        Booking Policies
                    </h4>
                    <p class="small text-muted m-0">
                        Please cancel or reschedule at least 24 hours in advance to avoid a cancellation fee. Payment is collected at the time of service unless otherwise noted.
                    </p>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const datePicker = document.getElementById('datePicker');
            const slotsContainer = document.getElementById('slotsContainer');
            const slotsHeader = document.getElementById('slotsHeader');
            const submitBtn = document.getElementById('submitBtn');
            const hiddenDate = document.getElementById('SelectedDate');
            const hiddenTime = document.getElementById('SelectedTime');
            
            const summaryDate = document.getElementById('summaryDate');
            const summaryTime = document.getElementById('summaryTime');
            const form = document.getElementById('bookingForm');

            let selectedTimeElement = null;

            datePicker.addEventListener('change', async function() {
                const date = this.value;
                if (!date) return;

                hiddenDate.value = date;
                const dateObj = new Date(date + 'T00:00:00'); // Force local
                summaryDate.textContent = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                summaryTime.textContent = '--:--';
                hiddenTime.value = '';
                submitBtn.disabled = true;

                slotsHeader.textContent = 'Loading times...';
                slotsContainer.innerHTML = '';

                try {
                    const response = await fetch(`/Patient/GetAvailableSlots?doctorId=@Model.DoctorId&date=${date}`);
                    const slots = await response.json();

                    slotsHeader.textContent = `Available Times on ${dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`;
                    
                    if (slots.length === 0) {
                        slotsContainer.innerHTML = '<p class="small text-muted">No slots available on this date.</p>';
                        return;
                    }

                    slots.forEach(slot => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-outline-dark rounded-pill px-4 py-2 fw-bold';
                        btn.textContent = slot;
                        
                        btn.addEventListener('click', function() {
                            if (selectedTimeElement) {
                                selectedTimeElement.className = 'btn btn-outline-dark rounded-pill px-4 py-2 fw-bold';
                            }
                            selectedTimeElement = this;
                            this.className = 'btn btn-dark rounded-pill px-4 py-2 fw-bold';
                            
                            // Parse time AM/PM to TimeSpan string (HH:mm:ss)
                            const timeParts = slot.match(/(\d+):(\d+) (AM|PM)/);
                            let hours = parseInt(timeParts[1]);
                            const mins = timeParts[2];
                            const ampm = timeParts[3];
                            
                            if (ampm === 'PM' && hours < 12) hours += 12;
                            if (ampm === 'AM' && hours === 12) hours = 0;
                            
                            hiddenTime.value = `${hours.toString().padStart(2, '0')}:${mins}:00`;
                            summaryTime.textContent = slot;
                            submitBtn.disabled = false;
                        });
                        
                        slotsContainer.appendChild(btn);
                    });
                } catch (e) {
                    slotsHeader.textContent = 'Error loading times';
                }
            });

            submitBtn.addEventListener('click', function() {
                if(hiddenDate.value && hiddenTime.value) {
                    form.submit();
                }
            });
        });
    </script>
}
