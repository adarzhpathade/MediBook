@model MediBook.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AppLayout";
}

<!-- Welcome Section -->
<div class="mb-5 d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-end gap-4">
    <div>
        <h1 class="display-4 fw-bold text-dark mb-2">Good morning, @Model.PatientFirstName</h1>
        <p class="fs-5 text-muted mb-0">Here's an overview of your healthcare journey today.</p>
    </div>
    <a href="@Url.Action("FindDoctors", "Patient")" class="btn btn-dark rounded-pill px-4 py-3 py-lg-2 d-flex justify-content-center align-items-center gap-2 shadow-sm w-100 w-lg-auto text-decoration-none" style="max-width: 300px;">
        <span class="material-symbols-outlined">add</span>
        <span class="fw-bold">Book Appointment</span>
    </a>
</div>

<!-- Quick Stats Bento Grid -->
<div class="row g-4 mb-5">
    <!-- Stat 1: Pink -->
    <div class="col-6 col-md-6 col-lg-3">
        <div class="bento-card pink shadow-sm">
            <div class="d-flex justify-content-between align-items-start position-relative z-1">
                <span class="fw-bold text-dark" style="opacity: 0.8">Upcoming Appointments</span>
                <span class="material-symbols-outlined fs-2 text-dark" style="opacity: 0.4">event</span>
            </div>
            <div class="position-relative z-1 mt-4">
                <div class="display-5 fw-bold text-dark">@Model.UpcomingAppointmentsCount</div>
                <div class="small fw-bold text-dark mt-1" style="opacity: 0.6">Next: @(Model.NextAppointment?.AppointmentDate.ToString("MMM dd") ?? "None")</div>
            </div>
            <div class="position-absolute rounded-circle bg-white" style="width: 120px; height: 120px; right: -30px; bottom: -30px; filter: blur(20px); opacity: 0.4;"></div>
        </div>
    </div>
    <!-- Stat 2: Blue -->
    <div class="col-6 col-md-6 col-lg-3">
        <div class="bento-card blue shadow-sm">
            <div class="d-flex justify-content-between align-items-start position-relative z-1">
                <span class="fw-bold text-dark" style="opacity: 0.8">Completed Visits</span>
                <span class="material-symbols-outlined fs-2 text-dark" style="opacity: 0.4">check_circle</span>
            </div>
            <div class="position-relative z-1 mt-4">
                <div class="display-5 fw-bold text-dark">@Model.CompletedVisitsCount</div>
                <div class="small fw-bold text-dark mt-1" style="opacity: 0.6">This year</div>
            </div>
            <div class="position-absolute bg-white rounded" style="width: 100px; height: 100px; right: -20px; top: -40px; transform: rotate(45deg); filter: blur(15px); opacity: 0.4;"></div>
        </div>
    </div>
    <!-- Stat 3: Green -->
    <div class="col-6 col-md-6 col-lg-3">
        <div class="bento-card green shadow-sm">
            <div class="d-flex justify-content-between align-items-start position-relative z-1">
                <span class="fw-bold text-dark" style="opacity: 0.8">Medical Reports</span>
                <span class="material-symbols-outlined fs-2 text-dark" style="opacity: 0.4">description</span>
            </div>
            <div class="position-relative z-1 mt-4">
                <div class="display-5 fw-bold text-dark">@Model.MedicalReportsCount</div>
                <div class="small fw-bold text-dark mt-1" style="opacity: 0.6">2 new since last login</div>
            </div>
            <div class="position-absolute rounded-circle bg-black" style="width: 110px; height: 110px; left: -30px; bottom: -10px; filter: blur(20px); opacity: 0.05;"></div>
        </div>
    </div>
    <!-- Stat 4: Yellow -->
    <div class="col-6 col-md-6 col-lg-3">
        <div class="bento-card yellow shadow-sm">
            <div class="d-flex justify-content-between align-items-start position-relative z-1">
                <span class="fw-bold text-dark" style="opacity: 0.8">Active Prescriptions</span>
                <span class="material-symbols-outlined fs-2 text-dark" style="opacity: 0.4">medication</span>
            </div>
            <div class="position-relative z-1 mt-4">
                <div class="display-5 fw-bold text-dark">@Model.ActivePrescriptionsCount</div>
                <div class="small fw-bold text-dark mt-1" style="opacity: 0.6">Need refill in 5 days</div>
            </div>
            <!-- Sparkline mock -->
            <div class="position-absolute d-flex align-items-end gap-1" style="bottom: 1rem; right: 1rem; height: 3rem; opacity: 0.4;">
                <div class="bg-dark rounded-pill" style="width: 8px; height: 100%;"></div>
                <div class="bg-dark rounded-pill" style="width: 8px; height: 75%;"></div>
                <div class="bg-dark rounded-pill" style="width: 8px; height: 50%;"></div>
                <div class="bg-dark rounded-pill" style="width: 8px; height: 66%;"></div>
                <div class="bg-dark rounded-pill" style="width: 8px; height: 33%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Grid -->
<div class="row g-4">
    <!-- Left Column -->
    <div class="col-lg-7 d-flex flex-column gap-4">
        
        <!-- Featured Upcoming Appointment -->
        <div class="bg-white rounded-4 p-4 shadow-sm border-0 position-relative overflow-hidden">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fs-5 fw-bold text-dark m-0">Next Appointment</h3>
                <span class="badge rounded-pill fw-bold" style="background-color: rgba(191, 212, 255, 0.3); color: var(--mb-primary); padding: 6px 16px;">
                    @(Model.NextAppointment?.Type ?? "Consultation")
                </span>
            </div>
            @if (Model.NextAppointment != null)
            {
                <div class="d-flex gap-4 align-items-center">
                    <div class="rounded-4 overflow-hidden shadow-sm flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 96px; height: 96px; background-color: rgba(191, 212, 255, 0.2);">
                        <span class="material-symbols-outlined fs-1" style="color: var(--mb-accent-blue);">medical_services</span>
                    </div>
                    <div>
                        <h4 class="fs-4 fw-bold text-dark mb-1">@Model.NextAppointment.DoctorName</h4>
                        <p class="text-muted mb-2">@Model.NextAppointment.Specialization &bull; @Model.NextAppointment.ClinicName</p>
                        <div class="d-flex gap-3 text-muted small fw-bold">
                            <div class="d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined" style="font-size: 16px;">calendar_today</span>
                                @{
                                    var apptDate = Model.NextAppointment.AppointmentDate.Date;
                                    var todayDate = DateTime.UtcNow.Date;
                                    var dateLabel = apptDate == todayDate ? "Today" :
                                                    apptDate == todayDate.AddDays(1) ? "Tomorrow" :
                                                    apptDate.ToString("ddd, MMM dd");
                                }
                                @dateLabel
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span>
                                @DateTime.Today.Add(Model.NextAppointment.AppointmentTime).ToString("hh:mm tt")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 d-flex gap-3">
                    <a href="@Url.Action("MyAppointments", "Patient")" class="btn btn-dark flex-grow-1 rounded-pill fw-bold py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm text-decoration-none">
                        <span class="material-symbols-outlined">event</span>
                        Manage Appointments
                    </a>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3" style="width: 80px; height: 80px; background-color: rgba(191, 212, 255, 0.2); color: var(--mb-accent-blue);">
                        <span class="material-symbols-outlined fs-1">event_available</span>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">No upcoming appointments</h4>
                    <p class="text-muted mb-4">You're all caught up! Ready to book your next visit?</p>
                    <a href="@Url.Action("FindDoctors", "Patient")" class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm">
                        Find a Doctor
                    </a>
                </div>
            }
        </div>

    </div>

    <!-- Right Column -->
    <div class="col-lg-5 d-flex flex-column gap-4">
        <!-- Quick Actions -->
        <div class="bg-white rounded-4 p-4 shadow-sm border-0 h-100">
            <h3 class="fs-5 fw-bold text-dark mb-4">Quick Actions</h3>
            <div class="d-grid gap-3">
                <a href="@Url.Action("FindDoctors", "Patient")" class="btn btn-light rounded-4 p-3 d-flex align-items-center gap-3 text-start text-decoration-none shadow-sm" style="border: 1px solid var(--mb-divider); background-color: var(--mb-surface-sec); transition: transform 0.2s;">
                    <div class="rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="width: 48px; height: 48px; background-color: var(--mb-accent-blue); color: var(--mb-primary);">
                        <span class="material-symbols-outlined">search</span>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Find a Doctor</div>
                        <div class="small text-muted">Search by specialty or name</div>
                    </div>
                </a>
                
                <a href="@Url.Action("MyAppointments", "Patient")" class="btn btn-light rounded-4 p-3 d-flex align-items-center gap-3 text-start text-decoration-none shadow-sm" style="border: 1px solid var(--mb-divider); background-color: var(--mb-surface-sec); transition: transform 0.2s;">
                    <div class="rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="width: 48px; height: 48px; background-color: var(--mb-accent-pink); color: var(--mb-primary);">
                        <span class="material-symbols-outlined">calendar_month</span>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">My Appointments</div>
                        <div class="small text-muted">View past and upcoming</div>
                    </div>
                </a>
                
                <a href="@Url.Action("Settings", "Patient")" class="btn btn-light rounded-4 p-3 d-flex align-items-center gap-3 text-start text-decoration-none shadow-sm" style="border: 1px solid var(--mb-divider); background-color: var(--mb-surface-sec); transition: transform 0.2s;">
                    <div class="rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="width: 48px; height: 48px; background-color: var(--mb-accent-green); color: var(--mb-primary);">
                        <span class="material-symbols-outlined">settings</span>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Profile Settings</div>
                        <div class="small text-muted">Update your details</div>
                    </div>
                </a>
            </div>
        </div>

    </div>
</div>
