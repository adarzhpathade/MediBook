@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HideNavFooter"] = true;
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="display-1 fw-bold text-danger"><i class="bi bi-shield-lock"></i></h1>
            <h2 class="fw-bold mt-4">Access Denied</h2>
            <p class="lead text-muted mt-3">
                You do not have permission to view this page. If you believe this is an error, please contact support.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark btn-lg mt-4 px-5 rounded-pill">Return to Home</a>
        </div>
    </div>
</div>
