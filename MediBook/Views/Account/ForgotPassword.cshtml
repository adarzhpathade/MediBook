@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HideNavFooter"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
                <h3 class="fw-bold mb-3">Forgot Password</h3>
                <p class="text-muted mb-4">
                    Enter your email address and we will send you a link to reset your password.
                </p>
                <form>
                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold">Email address</label>
                        <input type="email" class="form-control form-control-lg rounded-pill px-4" placeholder="Enter your email" required />
                    </div>
                    <button type="submit" class="btn btn-dark btn-lg w-100 rounded-pill mb-3">Send Reset Link</button>
                    <div class="text-center">
                        <a asp-action="Login" class="text-dark fw-bold text-decoration-none">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
