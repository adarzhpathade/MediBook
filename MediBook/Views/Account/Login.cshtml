@model MediBook.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HideNavFooter"] = true;
}

<style>
    .page-bg { background-color: #EFEBE4; } 
    .text-brand-dark { color: #111111; }
    .text-brand-gray { color: #7A7A7A; }

    .input-minimal {
        border-radius: 8px; height: 48px; background-color: #FFFFFF;
        border: 1px solid #E5E0D8; padding: 0 16px; transition: all 0.2s ease;
        width: 100%; font-size: 14px;
    }
    .input-minimal:focus { border-color: #111111; outline: none; box-shadow: 0 0 0 1px #111111; }
    input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 30px #FFFFFF inset !important;
        -webkit-text-fill-color: #111111 !important; border-radius: 8px;
    }

    .btn-minimal {
        background-color: #111111; color: white; border: none; border-radius: 9999px;
        height: 48px; font-weight: 500; font-size: 14px; transition: background-color 0.2s; width: 100%;
    }
    .btn-minimal:hover { background-color: #000000; }

    .btn-outline-dark-custom {
        background-color: transparent; color: #111111; border: 2px solid #111111; border-radius: 9999px;
        height: 48px; padding: 0 40px; font-weight: 600; font-size: 14px; transition: all 0.2s;
    }
    .btn-outline-dark-custom:hover { background-color: #111111; color: white; }

    .auth-container {
        background-color: #fff; border-radius: 20px; box-shadow: 0 24px 60px rgba(0,0,0,0.06);
        position: relative; overflow: hidden; width: 960px; max-width: 100%; min-height: 640px;
    }
    .form-container { position: absolute; top: 0; height: 100%; transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
    .sign-in-container { left: 0; width: 50%; z-index: 2; }
    .auth-container.right-panel-active .sign-in-container { transform: translateX(100%); opacity: 0; z-index: 1; }
    .sign-up-container { left: 0; width: 50%; opacity: 0; z-index: 1; }
    .auth-container.right-panel-active .sign-up-container { transform: translateX(100%); opacity: 1; z-index: 5; }

    .overlay-container {
        position: absolute; top: 0; left: 50%; width: 50%; height: 100%; overflow: hidden;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); z-index: 100;
    }
    .auth-container.right-panel-active .overlay-container { transform: translateX(-100%); }

    .overlay {
        background-color: #F9F5EE;
        background-image: 
            radial-gradient(circle at 10% 20%, rgba(244, 183, 216, 0.8) 0%, transparent 40%),
            radial-gradient(circle at 80% 30%, rgba(191, 212, 255, 0.8) 0%, transparent 40%),
            radial-gradient(circle at 40% 80%, rgba(168, 198, 125, 0.6) 0%, transparent 50%),
            radial-gradient(circle at 90% 90%, rgba(244, 183, 216, 0.7) 0%, transparent 40%);
        background-size: cover; position: relative; left: -100%; height: 100%; width: 200%;
        transform: translateX(0); transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .overlay::after {
        content: ""; position: absolute; inset: 0; background-size: 40px 40px;
        background-image: linear-gradient(to right, rgba(0,0,0,0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.03) 1px, transparent 1px);
        z-index: 1;
    }
    .auth-container.right-panel-active .overlay { transform: translateX(50%); }

    .overlay-panel {
        position: absolute; display: flex; align-items: center; justify-content: center; flex-direction: column;
        padding: 0 40px; text-align: center; top: 0; height: 100%; width: 50%; transform: translateX(0);
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); z-index: 2;
    }
    .overlay-left { transform: translateX(-20%); }
    .auth-container.right-panel-active .overlay-left { transform: translateX(0); }
    .overlay-right { right: 0; transform: translateX(0); }
    .auth-container.right-panel-active .overlay-right { transform: translateX(20%); }

    @@media (max-width: 767px) {
        body { 
            background-color: #F9F5EE;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(244, 183, 216, 0.4) 0%, transparent 40%),
                radial-gradient(circle at 90% 10%, rgba(191, 212, 255, 0.4) 0%, transparent 40%);
            background-attachment: fixed;
        }
        .page-bg { background: transparent !important; }
        .auth-container { min-height: auto; width: 100%; max-width: 400px; margin: 0 auto; border-radius: 32px; box-shadow: 0 16px 40px rgba(0,0,0,0.06); background: #ffffff; overflow: visible; display: flex; flex-direction: column; }
        .form-container { position: relative; width: 100%; height: auto; left: auto; transform: none !important; opacity: 1 !important; z-index: 1 !important; transition: none; padding: 48px 24px 32px 24px; border-radius: 32px; }
        
        .sign-up-container { display: none !important; }
        .sign-in-container { display: flex !important; }
        .auth-container.right-panel-active .sign-up-container { display: flex !important; }
        .auth-container.right-panel-active .sign-in-container { display: none !important; }
        
        .overlay-container { display: none !important; }
        .d-md-none { display: block !important; }
        
        .input-minimal { height: 52px; font-size: 15px; border-radius: 12px; }
        .btn-minimal { height: 52px; font-size: 15px; }
    }
</style>

<div class="container-fluid page-bg min-vh-100 d-flex flex-column justify-content-center align-items-center py-4 px-3">
    
    <div class="auth-container" id="authContainer">
        
        <!-- Sign Up Container -->
        <div class="form-container sign-up-container bg-white d-flex flex-column justify-content-center px-4 px-md-5">
            <div class="mb-4 d-flex justify-content-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #111111;">
                    <svg class="text-white" style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                </div>
            </div>
            <div class="text-center mb-4">
                <h1 class="fw-bold mb-2" style="font-size: 28px; letter-spacing: -0.5px;">Create an account</h1>
                <p class="text-brand-gray small">Join to access top-rated healthcare.</p>
            </div>
            
            <form asp-controller="Account" asp-action="Register" method="post" class="w-100">
                <div class="mb-3">
                    <input name="FullName" class="input-minimal" placeholder="Full name" required />
                </div>
                <div class="mb-3">
                    <input name="Email" class="input-minimal" placeholder="Enter your email" type="email" required />
                </div>
                <div class="mb-3">
                    <input name="Password" class="input-minimal" placeholder="Create a password" type="password" required />
                </div>
                <div class="mb-4">
                    <input name="ConfirmPassword" class="input-minimal" placeholder="Confirm your password" type="password" required />
                </div>
                <button type="submit" class="btn-minimal mb-4">Sign up with email</button>
            </form>
            
            <div class="text-center mt-auto d-md-none">
                <span class="text-brand-gray small">Already have an account?</span>
                <a href="#" id="mobileSignIn" class="text-dark fw-bold small text-decoration-none ms-1 border-bottom border-dark">Sign In</a>
            </div>
        </div>

        <!-- Sign In Container (Active by default in Login view) -->
        <div class="form-container sign-in-container bg-white d-flex flex-column justify-content-center px-4 px-md-5">
            <div class="mb-4 d-flex justify-content-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #111111;">
                    <svg class="text-white" style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                </div>
            </div>
            <div class="text-center mb-4">
                <h1 class="fw-bold mb-2" style="font-size: 28px; letter-spacing: -0.5px;">Welcome back!</h1>
                <p class="text-brand-gray small">Manage your healthcare schedules effortlessly.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" class="w-100">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                
                <div class="mb-3">
                    <input asp-for="Email" class="input-minimal" placeholder="Enter your email" type="email" />
                    <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                </div>
                <div class="mb-3">
                    <input asp-for="Password" class="input-minimal" placeholder="Enter your password" type="password" />
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check m-0">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" style="cursor:pointer;" />
                        <label asp-for="RememberMe" class="form-check-label text-brand-gray small" style="cursor:pointer; user-select:none;">Remember me</label>
                    </div>
                    <a asp-action="ForgotPassword" class="text-brand-gray small text-decoration-none border-bottom border-secondary">Forgot password?</a>
                </div>
                <button type="submit" class="btn-minimal mb-4">Sign in with email</button>
            </form>
            
            <div class="text-center mt-auto d-md-none">
                <span class="text-brand-gray small">Don't have an account?</span>
                <a href="#" id="mobileSignUp" class="text-dark fw-bold small text-decoration-none ms-1 border-bottom border-dark">Sign Up</a>
            </div>
        </div>

        <!-- Overlay Container -->
        <div class="overlay-container">
            <div class="overlay">
                <div class="overlay-panel overlay-left">
                    <h2 class="fw-bold mb-3">Welcome Back!</h2>
                    <p class="mb-4 px-4 text-dark opacity-75">To keep connected with us please login with your personal info</p>
                    <button class="btn-outline-dark-custom" id="signIn">Sign In</button>
                </div>
                <div class="overlay-panel overlay-right">
                    <h2 class="fw-bold mb-3">Hello, Friend!</h2>
                    <p class="mb-4 px-4 text-dark opacity-75">Enter your personal details and start your journey with us</p>
                    <button class="btn-outline-dark-custom" id="signUp">Sign Up</button>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const signUpBtn = document.getElementById('signUp');
        const signInBtn = document.getElementById('signIn');
        const mobileSignUp = document.getElementById('mobileSignUp');
        const mobileSignIn = document.getElementById('mobileSignIn');
        const container = document.getElementById('authContainer');

        if (signUpBtn) signUpBtn.addEventListener('click', () => container.classList.add("right-panel-active"));
        if (signInBtn) signInBtn.addEventListener('click', () => container.classList.remove("right-panel-active"));
        
        if (mobileSignUp) {
            mobileSignUp.addEventListener('click', (e) => {
                e.preventDefault();
                container.classList.add("right-panel-active");
            });
        }
        if (mobileSignIn) {
            mobileSignIn.addEventListener('click', (e) => {
                e.preventDefault();
                container.classList.remove("right-panel-active");
            });
        }
    });
</script>
