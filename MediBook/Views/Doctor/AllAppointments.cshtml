@model IEnumerable<MediBook.Models.DTOs.AppointmentDto>

@{
    ViewData["Title"] = "All Appointments";
    Layout = "_AppLayout";
    var currentFilter = ViewBag.CurrentFilter as string;
}

<div class="mb-5">
    <h1 class="display-6 fw-bold text-dark mb-2">All Appointments</h1>
    <p class="fs-5 text-muted mb-0">View and manage your complete appointment history.</p>
</div>

<div class="bg-white rounded-4 p-4 shadow-sm border-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <h3 class="fs-5 fw-bold text-dark m-0">Appointment History</h3>
        
        <form method="get" asp-action="AllAppointments" class="d-flex">
            <div class="position-relative">
                <select name="status" class="form-select rounded-pill px-4 shadow-sm" style="background-color: var(--mb-surface-sec); border-color: var(--mb-divider); min-width: 180px;" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(currentFilter))">All Statuses</option>
                    <option value="Pending" selected="@(currentFilter == "Pending")">Pending</option>
                    <option value="Confirmed" selected="@(currentFilter == "Confirmed")">Confirmed</option>
                    <option value="Rescheduled" selected="@(currentFilter == "Rescheduled")">Rescheduled</option>
                    <option value="Completed" selected="@(currentFilter == "Completed")">Completed</option>
                    <option value="Declined" selected="@(currentFilter == "Declined")">Declined</option>
                    <option value="Cancelled" selected="@(currentFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
        </form>
    </div>
    
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table text-dark align-middle text-nowrap border-0" id="allAppointmentsTable">
                <thead>
                    <tr style="border-bottom: 2px solid var(--mb-divider);">
                        <th class="border-0 fw-bold text-muted pb-3">Patient Name</th>
                        <th class="border-0 fw-bold text-muted pb-3">Date & Time</th>
                        <th class="border-0 fw-bold text-muted pb-3">Reason</th>
                        <th class="border-0 fw-bold text-muted pb-3">Status</th>
                        <th class="border-0 fw-bold text-muted pb-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody style="border-top: none;">
                    @foreach (var appointment in Model.OrderByDescending(a => a.AppointmentDate).ThenByDescending(a => a.AppointmentTime))
                    {
                        <tr style="border-bottom: 1px solid var(--mb-divider);">
                            <td class="py-4">
                                <div class="fw-bold text-dark">@appointment.PatientName</div>
                            </td>
                            <td class="py-4">
                                <div class="fw-bold text-dark">@appointment.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted">@appointment.AppointmentTime.ToString(@"hh\:mm")</div>
                            </td>
                            <td class="py-4">
                                <div class="text-muted" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @(appointment.Reason ?? "Not specified")
                                </div>
                            </td>
                            <td class="py-4">
                                @{
                                    var (bgAlpha, textColor, dotColor) = appointment.Status switch
                                    {
                                        "Pending" => ("rgba(246, 211, 94, 0.2)", "var(--mb-primary)", "var(--mb-accent-yellow)"),
                                        "Confirmed" => ("rgba(168, 198, 125, 0.2)", "var(--mb-primary)", "var(--mb-accent-green)"),
                                        "Rescheduled" => ("rgba(191, 212, 255, 0.2)", "var(--mb-primary)", "var(--mb-accent-blue)"),
                                        "Completed" => ("rgba(0, 0, 0, 0.05)", "var(--mb-primary)", "var(--mb-primary)"),
                                        "Declined" => ("rgba(253, 226, 225, 0.5)", "var(--mb-primary)", "var(--mb-accent-pink)"),
                                        "Cancelled" => ("rgba(0, 0, 0, 0.05)", "var(--mb-primary)", "var(--mb-primary)"),
                                        _ => ("rgba(191, 212, 255, 0.2)", "var(--mb-primary)", "var(--mb-accent-blue)")
                                    };
                                }
                                <span class="badge rounded-pill fw-bold d-inline-flex align-items-center gap-2" style="background-color: @bgAlpha; color: @textColor; padding: 6px 14px;">
                                    <span class="rounded-circle" style="width: 8px; height: 8px; background-color: @dotColor;"></span>
                                    @appointment.Status
                                </span>
                            </td>
                            <td class="py-4 text-end">
                                @if (appointment.Status == "Confirmed" || appointment.Status == "Rescheduled")
                                {
                                    <form asp-action="CompleteAppointment" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                        <button type="submit" class="btn btn-outline-dark rounded-pill fw-bold px-3 py-1 text-nowrap" style="font-size: 13px;">Mark Completed</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small fw-bold pe-3">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <span class="material-symbols-outlined mb-3" style="font-size: 48px; opacity: 0.2;">receipt_long</span>
            <p class="mb-0 fs-5">No appointments found matching your criteria.</p>
        </div>
    }
</div>
