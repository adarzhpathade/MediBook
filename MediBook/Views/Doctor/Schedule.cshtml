@model IEnumerable<MediBook.Models.DTOs.AppointmentDto>

@{
    ViewData["Title"] = "Schedule Management";
    Layout = "_AppLayout";
}

<div class="mb-5">
    <h1 class="display-6 fw-bold text-dark mb-2">My Schedule</h1>
    <p class="fs-5 text-muted mb-0">View your confirmed and rescheduled appointments.</p>
</div>

<div class="bg-white rounded-4 p-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fs-5 fw-bold text-dark m-0">Upcoming Appointments</h3>
    </div>
    
    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var appointment in Model.OrderBy(a => a.AppointmentDate).ThenBy(a => a.AppointmentTime))
            {
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center p-4 rounded-4" style="background-color: var(--mb-surface-sec);">
                    <div class="d-flex gap-4 align-items-center mb-3 mb-md-0">
                        <div class="rounded-3 d-flex flex-column align-items-center justify-content-center fw-bold shadow-sm bg-white" style="width: 64px; height: 64px; color: var(--mb-primary);">
                            <span class="fs-5" style="line-height: 1;">@appointment.AppointmentDate.ToString("dd")</span>
                            <span class="small text-muted" style="font-size: 11px;">@appointment.AppointmentDate.ToString("MMM")</span>
                        </div>
                        <div>
                            <div class="fs-5 fw-bold text-dark mb-1">@appointment.PatientName</div>
                            <div class="d-flex gap-3 small text-muted fw-bold">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span>
                                    @appointment.AppointmentTime.ToString(@"hh\:mm")
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(appointment.Reason))
                            {
                                <div class="small text-muted mt-2">
                                    <span class="fw-bold">Reason:</span> @appointment.Reason
                                </div>
                            }
                        </div>
                    </div>
                    <div>
                        <span class="badge rounded-pill fw-bold" style="background-color: rgba(168, 198, 125, 0.3); color: var(--mb-primary); padding: 8px 16px;">
                            @appointment.Status
                        </span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <span class="material-symbols-outlined mb-3" style="font-size: 48px; opacity: 0.2;">calendar_month</span>
            <p class="mb-0 fs-5">You have no upcoming appointments scheduled.</p>
        </div>
    }
</div>
