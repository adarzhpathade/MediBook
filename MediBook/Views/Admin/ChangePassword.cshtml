@model MediBook.Models.ViewModels.AdminChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_AppLayout";
}

<div class="mb-5">
    <div class="d-flex align-items-center gap-3 mb-2">
        <a asp-action="Profile" class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center text-dark" style="width: 40px; height: 40px;">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h1 class="display-5 fw-bold text-dark m-0">Change Password</h1>
    </div>
    <p class="text-muted mb-0 ms-5 ps-2">Update your administrative account password.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="bg-white rounded-4 shadow-sm p-4 p-md-5">
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success rounded-3 border-0 fw-bold mb-4">
                    @Model.SuccessMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger rounded-3 border-0 fw-bold mb-4">
                    @Model.ErrorMessage
                </div>
            }

            <form asp-action="ChangePassword" method="post">
                <div class="mb-4">
                    <label asp-for="CurrentPassword" class="form-label fw-bold text-muted small">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control rounded-pill bg-light border-0 py-3 px-4 shadow-none" placeholder="Enter current password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block ms-3"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label fw-bold text-muted small">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control rounded-pill bg-light border-0 py-3 px-4 shadow-none" placeholder="Enter new password" />
                    <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block ms-3"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-bold text-muted small">Confirm New Password</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control rounded-pill bg-light border-0 py-3 px-4 shadow-none" placeholder="Confirm new password" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block ms-3"></span>
                </div>

                <button type="submit" class="btn btn-dark rounded-pill fw-bold py-3 px-5 w-100">Update Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
