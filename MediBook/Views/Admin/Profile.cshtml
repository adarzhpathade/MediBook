@model MediBook.Models.ViewModels.AdminProfileViewModel
@{
    ViewData["Title"] = "Admin Profile";
    Layout = "_AppLayout";
}

<div class="mb-5">
    <h1 class="display-5 fw-bold text-dark mb-1">Admin Profile</h1>
    <p class="text-muted mb-0">Manage your administrative account details.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="bg-white rounded-4 shadow-sm p-4 p-md-5">
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success rounded-3 border-0 fw-bold mb-4">
                    @Model.SuccessMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger rounded-3 border-0 fw-bold mb-4">
                    @Model.ErrorMessage
                </div>
            }

            <form asp-action="Profile" method="post">
                <div class="mb-4 text-center">
                    <div class="text-muted small fw-bold text-uppercase">Administrator</div>
                </div>

                <div class="mb-4">
                    <label asp-for="FullName" class="form-label fw-bold text-muted small">Full Name</label>
                    <input asp-for="FullName" class="form-control rounded-pill bg-light border-0 py-3 px-4 shadow-none" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block ms-3"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Email" class="form-label fw-bold text-muted small">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control rounded-pill bg-light border-0 py-3 px-4 shadow-none" readonly title="Email cannot be changed directly." />
                    <div class="form-text ms-3 small">To change your email, please contact IT support.</div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3">
                    <button type="submit" class="btn btn-dark rounded-pill fw-bold py-3 px-5 w-100">Save Changes</button>
                    <a asp-action="ChangePassword" class="btn btn-outline-dark rounded-pill fw-bold py-3 px-4 text-center w-100">Change Password</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
