@model IEnumerable<MediBook.Models.DTOs.AppointmentDto>
@{
    ViewData["Title"] = "Manage Appointments";
    Layout = "_AppLayout";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="display-5 fw-bold text-dark mb-1">Manage Appointments</h1>
        <p class="text-muted mb-0">View, search, and filter all platform appointments.</p>
    </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-4 shadow-sm p-4 mb-5">
    <form asp-action="ManageAppointments" method="get" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label fw-bold text-muted small">Search Patient or Doctor</label>
            <div class="d-flex align-items-center bg-light rounded-pill px-3 py-1">
                <span class="material-symbols-outlined text-muted">search</span>
                <input type="text" name="search" class="form-control border-0 shadow-none bg-transparent" placeholder="Name..." value="@ViewBag.SearchTerm" />
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold text-muted small">Status Filter</label>
            <select name="status" class="form-select rounded-pill bg-light border-0 py-2 px-4 shadow-none">
                <option value="">All Statuses</option>
                <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
                <option value="Confirmed" selected="@(ViewBag.StatusFilter == "Confirmed")">Confirmed</option>
                <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark rounded-pill fw-bold w-100 py-2">Apply</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || !string.IsNullOrEmpty(ViewBag.StatusFilter))
            {
                <a asp-action="ManageAppointments" class="btn btn-light rounded-pill fw-bold py-2 px-3 text-muted">Clear</a>
            }
        </div>
    </form>
</div>

<!-- Appointments List -->
<div class="bg-white rounded-4 p-4 shadow-sm border-0">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle text-nowrap mb-0">
                <thead class="text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3 border-0 rounded-start">Date & Time</th>
                        <th class="border-0">Patient</th>
                        <th class="border-0">Doctor</th>
                        <th class="border-0">Status</th>
                        <th class="text-end pe-3 border-0 rounded-end">Action</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var appt in Model)
                    {
                        <tr>
                            <td class="ps-3 border-bottom-0 py-3">
                                <div class="fw-bold text-dark">@appt.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                <div class="text-muted small">
                                    <span class="material-symbols-outlined align-middle me-1" style="font-size: 14px;">schedule</span>
                                    @DateTime.Today.Add(appt.AppointmentTime).ToString("hh:mm tt")
                                </div>
                            </td>
                            <td class="border-bottom-0">
                                <div class="fw-bold">@appt.PatientName</div>
                            </td>
                            <td class="border-bottom-0">
                                <div class="fw-bold">@appt.DoctorName</div>
                                <div class="text-muted small">@appt.DoctorSpecialization</div>
                            </td>
                            <td class="border-bottom-0">
                                @{
                                    var badgeClass = appt.Status switch
                                    {
                                        "Confirmed" => "bg-success bg-opacity-10 text-success",
                                        "Pending" => "bg-warning bg-opacity-10 text-warning",
                                        "Cancelled" => "bg-danger bg-opacity-10 text-danger",
                                        "Completed" => "bg-info bg-opacity-10 text-info",
                                        _ => "bg-secondary bg-opacity-10 text-secondary"
                                    };
                                }
                                <span class="badge rounded-pill fw-bold @badgeClass" style="padding: 6px 12px;">@appt.Status</span>
                            </td>
                            <td class="text-end pe-3 border-bottom-0">
                                <a asp-action="AppointmentDetails" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-light rounded-pill fw-bold text-dark px-3 shadow-sm d-inline-flex align-items-center gap-1">
                                    <span class="material-symbols-outlined fs-6">visibility</span> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <span class="material-symbols-outlined display-1 mb-3" style="opacity: 0.2;">event_busy</span>
            <h3 class="fs-5 fw-bold text-dark">No appointments found</h3>
            <p>Try adjusting your search criteria or filters.</p>
        </div>
    }
</div>
