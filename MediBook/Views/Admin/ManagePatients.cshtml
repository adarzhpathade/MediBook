@model IEnumerable<MediBook.Models.DTOs.PatientProfileDto>
@{
    ViewData["Title"] = "Manage Patients";
    Layout = "_AppLayout";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="display-5 fw-bold text-dark mb-1">Manage Patients</h1>
        <p class="text-muted mb-0">View, search, and manage patient accounts on the platform.</p>
    </div>
</div>



<!-- Search Bar -->
<div class="bg-white rounded-pill shadow-sm p-2 mb-5 d-flex align-items-center" style="max-width: 600px;">
    <form asp-action="ManagePatients" method="get" class="d-flex w-100 align-items-center m-0">
        <span class="material-symbols-outlined text-muted ms-3">search</span>
        <input type="text" name="search" class="form-control border-0 shadow-none bg-transparent ms-2" placeholder="Search patients by name, email, or phone..." value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-dark rounded-pill fw-bold px-4">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
        {
            <a asp-action="ManagePatients" class="btn btn-light rounded-pill ms-2 text-muted">Clear</a>
        }
    </form>
</div>

<!-- Patients List -->
<div class="bg-white rounded-4 p-4 shadow-sm border-0">
    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var patient in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 rounded-4 p-4 d-flex flex-column shadow-sm transition-all hover-shadow" style="background-color: var(--mb-surface-sec);">
                        <!-- Header with Name & Status -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="fw-bold text-dark fs-5">@patient.FullName</div>
                            <div>
                                @if (patient.IsActive)
                                {
                                    <span class="badge rounded-pill fw-bold" style="background-color: rgba(168, 198, 125, 0.3); color: var(--mb-primary); padding: 6px 12px;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill fw-bold" style="background-color: rgba(230, 114, 114, 0.2); color: #d32f2f; padding: 6px 12px;">Inactive</span>
                                }
                            </div>
                        </div>
                        
                        <!-- Content -->
                        <div class="flex-grow-1">
                            <div class="text-muted small mb-3">@patient.Email</div>
                            
                            @if (!string.IsNullOrEmpty(patient.Address))
                            {
                                <div class="text-muted mb-3" style="font-size: 13.5px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    <span class="material-symbols-outlined align-text-bottom me-1" style="font-size: 15px;">location_on</span>@patient.Address
                                </div>
                            }
                            
                            <div class="d-flex flex-column gap-2 mb-3 small text-muted">
                                <span class="d-flex align-items-center gap-2"><span class="material-symbols-outlined" style="font-size: 16px;">phone</span> @(string.IsNullOrEmpty(patient.Phone) ? "No Phone" : patient.Phone)</span>
                                <span class="d-flex align-items-center gap-2"><span class="material-symbols-outlined" style="font-size: 16px;">event</span> Joined: @patient.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                        
                        <!-- Actions Footer -->
                        <div class="d-flex gap-2 mt-auto pt-3 border-top" style="border-color: rgba(0,0,0,0.05) !important;">
                            <!-- Toggle Status -->
                            <form asp-action="TogglePatientStatus" method="post" class="m-0 flex-grow-1">
                                <input type="hidden" name="id" value="@patient.PatientId" />
                                <button type="submit" class="btn btn-sm w-100 @(patient.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill fw-bold">
                                    @(patient.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                            
                            <!-- Delete -->
                            <form asp-action="DeletePatient" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to completely delete @patient.FullName? This cannot be undone.');">
                                <input type="hidden" name="id" value="@patient.PatientId" />
                                <button type="submit" class="btn btn-sm btn-danger rounded-pill fw-bold d-flex justify-content-center align-items-center h-100 px-3" title="Delete Patient">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <span class="material-symbols-outlined display-1 mb-3" style="opacity: 0.2;">search_off</span>
            <h3 class="fs-5 fw-bold text-dark">No patients found</h3>
            <p>Try adjusting your search criteria.</p>
        </div>
    }
</div>
